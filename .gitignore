# --- Rust ---
# Build output (sim core, any crate). Cargo.lock IS committed (this builds apps/binaries).
/target/
**/target/
# Backtrace/debug artifacts
*.pdb

# --- Tauri ---
# Tauri's Rust build output lives under its own target dir
/src-tauri/target/

# --- Web front end (Node) ---
node_modules/
dist/
build/
out/
.svelte-kit/
.vite/
*.tsbuildinfo

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
!.vscode/extensions.json

# --- Generated match replays (tithe play --out) ---
/match.html
/*.replay.html

# --- Logs ---
*.log
npm-debug.log*

# --- Claude Code local overrides (shared config + hooks are committed) ---
.claude/settings.local.json

# --- Playwright UI tests (e2e): keep config/specs, drop installs + artifacts ---
/e2e/node_modules/
/e2e/shots/
/e2e/test-results/
/e2e/playwright-report/
